{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "snInstance": { "type": "String" },
    "snUser": { "type": "String" },
    "snPassword": { "type": "SecureString" },
    "correlationTag": { "type": "String", "defaultValue": "SYNTH-SKR-LIVE" },
    "callerUserName": { "type": "String", "defaultValue": "synth.svc.azuremonitor" },
    "automationAccountId": { "type": "String" },
    "closeCodeValue": { "type": "String", "defaultValue": "Auto-remediated (AIOps)" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": { "schema": {} }
    }
  },
  "actions": {
    "Alert": {
      "type": "Compose",
      "inputs": {
        "condition": "@{triggerBody()?['data']?['essentials']?['monitorCondition']}",
        "rule": "@{triggerBody()?['data']?['essentials']?['alertRule']}",
        "severity": "@{triggerBody()?['data']?['essentials']?['severity']}",
        "summary": "@{triggerBody()?['data']?['essentials']?['description']}",
        "resource": "@{last(split(toLower(first(triggerBody()?['data']?['essentials']?['alertTargetIDs'])), '/'))}",
        "alertGuid": "@{last(split(triggerBody()?['data']?['essentials']?['alertId'], '/'))}",
        "firedAt": "@{triggerBody()?['data']?['essentials']?['firedDateTime']}",
        "resolvedAt": "@{triggerBody()?['data']?['essentials']?['resolvedDateTime']}",
        "metric": "@{coalesce(triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricName'], 'Log query result')}",
        "observed": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricValue']}",
        "operator": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['operator']}",
        "threshold": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['threshold']}",
        "window": "@{triggerBody()?['data']?['alertContext']?['condition']?['windowSize']}"
      },
      "runAfter": {}
    },
    "Init_successful_jobs": {
      "type": "InitializeVariable",
      "inputs": { "variables": [ { "name": "successfulJobs", "type": "array", "value": [] } ] },
      "runAfter": { "Alert": [ "Succeeded" ] }
    },
    "Fired_or_resolved": {
      "type": "If",
      "expression": {
        "and": [ { "equals": [ "@outputs('Alert')?['condition']", "Fired" ] } ]
      },
      "actions": {
        "Get_CI": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/cmdb_ci",
            "queries": {
              "sysparm_query": "name=@{outputs('Alert')?['resource']}",
              "sysparm_fields": "sys_id,name",
              "sysparm_limit": "1"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": {}
        },
        "Get_caller": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/sys_user",
            "queries": {
              "sysparm_query": "user_name=@{parameters('callerUserName')}",
              "sysparm_fields": "sys_id",
              "sysparm_limit": "1"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": {}
        },
        "Create_incident": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident",
            "queries": { "sysparm_fields": "sys_id,number" },
            "headers": { "Content-Type": "application/json", "Accept": "application/json" },
            "body": {
              "short_description": "[Azure Monitor] @{outputs('Alert')?['severity']} - @{outputs('Alert')?['summary']}",
              "description": "Auto-generated by Azure Monitor action group.\nAlert rule: @{outputs('Alert')?['rule']} (@{outputs('Alert')?['severity']})\nResource: @{outputs('Alert')?['resource']}\n@{outputs('Alert')?['metric']}: @{outputs('Alert')?['observed']} (@{outputs('Alert')?['operator']} @{outputs('Alert')?['threshold']}) over @{outputs('Alert')?['window']}\nFired: @{outputs('Alert')?['firedAt']}\nAlert id: @{outputs('Alert')?['alertGuid']}",
              "cmdb_ci": "@{body('Get_CI')?['result']?[0]?['sys_id']}",
              "caller_id": "@{body('Get_caller')?['result']?[0]?['sys_id']}",
              "category": "hardware",
              "impact": "2",
              "urgency": "2",
              "correlation_id": "@{parameters('correlationTag')}",
              "correlation_display": "@{outputs('Alert')?['alertGuid']}"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": { "Get_CI": [ "Succeeded" ], "Get_caller": [ "Succeeded" ] }
        }
      },
      "else": {
        "actions": {
          "Find_open_incident": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident",
              "queries": {
                "sysparm_query": "correlation_id=@{parameters('correlationTag')}^correlation_display=@{outputs('Alert')?['alertGuid']}^stateIN1,2,3",
                "sysparm_fields": "sys_id,number,state",
                "sysparm_limit": "1"
              },
              "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
            },
            "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
            "runAfter": {}
          },
          "If_open_incident": {
            "type": "If",
            "expression": {
              "and": [ { "greater": [ "@length(body('Find_open_incident')?['result'])", 0 ] } ]
            },
            "actions": {
              "List_completed_jobs": {
                "type": "Http",
                "inputs": {
                  "method": "GET",
                  "uri": "https://management.azure.com@{parameters('automationAccountId')}/jobs",
                  "queries": {
                    "api-version": "2023-11-01",
                    "$filter": "properties/status eq 'Completed' and properties/startTime ge @{formatDateTime(outputs('Alert')?['firedAt'], 'yyyy-MM-ddTHH:mm:ssZ')}"
                  },
                  "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com" }
                },
                "runAfter": {}
              },
              "For_each_job": {
                "type": "Foreach",
                "foreach": "@body('List_completed_jobs')?['value']",
                "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                "actions": {
                  "Get_job": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "https://management.azure.com@{items('For_each_job')?['id']}",
                      "queries": { "api-version": "2023-11-01" },
                      "authentication": { "type": "ManagedServiceIdentity", "audience": "https://management.azure.com" }
                    },
                    "runAfter": {}
                  },
                  "If_job_for_this_incident": {
                    "type": "If",
                    "expression": {
                      "and": [ { "equals": [
                        "@body('Get_job')?['properties']?['parameters']?['IncidentNumber']",
                        "@body('Find_open_incident')?['result']?[0]?['number']" ] } ]
                    },
                    "actions": {
                      "Record_job": {
                        "type": "AppendToArrayVariable",
                        "inputs": {
                          "name": "successfulJobs",
                          "value": "@{body('Get_job')?['properties']?['runbook']?['name']} job @{body('Get_job')?['name']} completed @{body('Get_job')?['properties']?['endTime']}"
                        },
                        "runAfter": {}
                      }
                    },
                    "else": { "actions": {} },
                    "runAfter": { "Get_job": [ "Succeeded" ] }
                  }
                },
                "runAfter": { "List_completed_jobs": [ "Succeeded" ] }
              },
              "If_remediated": {
                "type": "If",
                "expression": {
                  "and": [ { "greater": [ "@length(variables('successfulJobs'))", 0 ] } ]
                },
                "actions": {
                  "Resolve_incident": {
                    "type": "Http",
                    "inputs": {
                      "method": "PATCH",
                      "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident/@{body('Find_open_incident')?['result']?[0]?['sys_id']}",
                      "headers": { "Content-Type": "application/json" },
                      "body": {
                        "state": "6",
                        "close_code": "@{parameters('closeCodeValue')}",
                        "close_notes": "Auto-remediated by AIOps. Approved runbook: @{join(variables('successfulJobs'), '; ')}. Azure Monitor alert @{outputs('Alert')?['rule']} cleared at @{outputs('Alert')?['resolvedAt']} (@{outputs('Alert')?['metric']}: @{outputs('Alert')?['observed']}). Reopen if the problem returns.",
                        "work_notes": "[Azure Monitor] Alert @{outputs('Alert')?['rule']} resolved at @{outputs('Alert')?['resolvedAt']} after a successful approved runbook (@{join(variables('successfulJobs'), '; ')}). Incident resolved automatically."
                      },
                      "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
                    },
                    "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Add_review_note": {
                      "type": "Http",
                      "inputs": {
                        "method": "PATCH",
                        "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident/@{body('Find_open_incident')?['result']?[0]?['sys_id']}",
                        "headers": { "Content-Type": "application/json" },
                        "body": {
                          "work_notes": "[Azure Monitor] Alert @{outputs('Alert')?['rule']} cleared at @{outputs('Alert')?['resolvedAt']} (@{outputs('Alert')?['metric']}: @{outputs('Alert')?['observed']}), but no successful approved runbook job was found for this incident. Needs review: the symptom may have cleared on its own."
                        },
                        "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
                      },
                      "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
                      "runAfter": {}
                    }
                  }
                },
                "runAfter": { "For_each_job": [ "Succeeded" ] }
              }
            },
            "else": { "actions": {} },
            "runAfter": { "Find_open_incident": [ "Succeeded" ] }
          }
        }
      },
      "runAfter": { "Init_successful_jobs": [ "Succeeded" ] }
    }
  },
  "outputs": {}
}

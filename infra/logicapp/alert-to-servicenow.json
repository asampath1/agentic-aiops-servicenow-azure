{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "snInstance": { "type": "String" },
    "snUser": { "type": "String" },
    "snPassword": { "type": "SecureString" },
    "correlationTag": { "type": "String", "defaultValue": "SYNTH-SKR-LIVE" },
    "callerUserName": { "type": "String", "defaultValue": "synth.svc.azuremonitor" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": { "schema": {} }
    }
  },
  "actions": {
    "Alert": {
      "type": "Compose",
      "inputs": {
        "condition": "@{triggerBody()?['data']?['essentials']?['monitorCondition']}",
        "rule": "@{triggerBody()?['data']?['essentials']?['alertRule']}",
        "severity": "@{triggerBody()?['data']?['essentials']?['severity']}",
        "summary": "@{triggerBody()?['data']?['essentials']?['description']}",
        "resource": "@{last(split(toLower(first(triggerBody()?['data']?['essentials']?['alertTargetIDs'])), '/'))}",
        "alertGuid": "@{last(split(triggerBody()?['data']?['essentials']?['alertId'], '/'))}",
        "firedAt": "@{triggerBody()?['data']?['essentials']?['firedDateTime']}",
        "resolvedAt": "@{triggerBody()?['data']?['essentials']?['resolvedDateTime']}",
        "metric": "@{coalesce(triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricName'], 'Log query result')}",
        "observed": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['metricValue']}",
        "operator": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['operator']}",
        "threshold": "@{triggerBody()?['data']?['alertContext']?['condition']?['allOf']?[0]?['threshold']}",
        "window": "@{triggerBody()?['data']?['alertContext']?['condition']?['windowSize']}"
      },
      "runAfter": {}
    },
    "Fired_or_resolved": {
      "type": "If",
      "expression": {
        "and": [ { "equals": [ "@outputs('Alert')?['condition']", "Fired" ] } ]
      },
      "actions": {
        "Get_CI": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/cmdb_ci",
            "queries": {
              "sysparm_query": "name=@{outputs('Alert')?['resource']}",
              "sysparm_fields": "sys_id,name",
              "sysparm_limit": "1"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": {}
        },
        "Get_caller": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/sys_user",
            "queries": {
              "sysparm_query": "user_name=@{parameters('callerUserName')}",
              "sysparm_fields": "sys_id",
              "sysparm_limit": "1"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": {}
        },
        "Create_incident": {
          "type": "Http",
          "inputs": {
            "method": "POST",
            "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident",
            "queries": { "sysparm_fields": "sys_id,number" },
            "headers": { "Content-Type": "application/json", "Accept": "application/json" },
            "body": {
              "short_description": "[Azure Monitor] @{outputs('Alert')?['severity']} - @{outputs('Alert')?['summary']}",
              "description": "Auto-generated by Azure Monitor action group.\nAlert rule: @{outputs('Alert')?['rule']} (@{outputs('Alert')?['severity']})\nResource: @{outputs('Alert')?['resource']}\n@{outputs('Alert')?['metric']}: @{outputs('Alert')?['observed']} (@{outputs('Alert')?['operator']} @{outputs('Alert')?['threshold']}) over @{outputs('Alert')?['window']}\nFired: @{outputs('Alert')?['firedAt']}\nAlert id: @{outputs('Alert')?['alertGuid']}",
              "cmdb_ci": "@{body('Get_CI')?['result']?[0]?['sys_id']}",
              "caller_id": "@{body('Get_caller')?['result']?[0]?['sys_id']}",
              "category": "hardware",
              "impact": "2",
              "urgency": "2",
              "correlation_id": "@{parameters('correlationTag')}",
              "correlation_display": "@{outputs('Alert')?['alertGuid']}"
            },
            "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
          },
          "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
          "runAfter": { "Get_CI": [ "Succeeded" ], "Get_caller": [ "Succeeded" ] }
        }
      },
      "else": {
        "actions": {
          "Find_incident": {
            "type": "Http",
            "inputs": {
              "method": "GET",
              "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident",
              "queries": {
                "sysparm_query": "correlation_id=@{parameters('correlationTag')}^correlation_display=@{outputs('Alert')?['alertGuid']}",
                "sysparm_fields": "sys_id,number",
                "sysparm_limit": "1"
              },
              "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
            },
            "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
            "runAfter": {}
          },
          "If_found": {
            "type": "If",
            "expression": {
              "and": [ { "greater": [ "@length(body('Find_incident')?['result'])", 0 ] } ]
            },
            "actions": {
              "Add_resolved_note": {
                "type": "Http",
                "inputs": {
                  "method": "PATCH",
                  "uri": "https://@{parameters('snInstance')}.service-now.com/api/now/table/incident/@{body('Find_incident')?['result']?[0]?['sys_id']}",
                  "headers": { "Content-Type": "application/json" },
                  "body": {
                    "work_notes": "[Azure Monitor] Alert @{outputs('Alert')?['rule']} resolved at @{outputs('Alert')?['resolvedAt']} (@{outputs('Alert')?['metric']}: @{outputs('Alert')?['observed']})."
                  },
                  "authentication": { "type": "Basic", "username": "@parameters('snUser')", "password": "@parameters('snPassword')" }
                },
                "runtimeConfiguration": { "secureData": { "properties": [ "inputs" ] } },
                "runAfter": {}
              }
            },
            "else": { "actions": {} },
            "runAfter": { "Find_incident": [ "Succeeded" ] }
          }
        }
      },
      "runAfter": { "Alert": [ "Succeeded" ] }
    }
  },
  "outputs": {}
}
